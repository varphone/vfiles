{
  "name": "vfiles-client",
  "version": "2.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:styles": "node scripts/check-dead-styles.mjs",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "check": "bun run lint && bun run lint:styles && bun run test",
    "size:check": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.44.0",
    "axios": "^1.16.1",
    "bulma": "^1.0.4",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.2"
  }
}
