{
  "name": "vfiles-client",
  "version": "2.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:styles": "node scripts/check-dead-styles.mjs",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "check": "bun run lint && bun run lint:styles && bun run typecheck && bun run test",
    "size:check": "node scripts/check-size.mjs"
  },
  "overrides": {
    "brace-expansion@<1.1.17": "^1.1.17",
    "immutable": "^5.1.9",
    "js-yaml@<=4.1.1": "^4.3.2",
    "nanoid@<3.3.16": "^3.3.19",
    "picomatch@<2.3.2": "^2.3.2",
    "postcss@<=8.5.22": "^8.5.28",
    "undici": "^7.29.0"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.48.0",
    "axios": "^1.20.0",
    "bulma": "^1.0.4",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
