# VFiles 示例环境变量
# 复制为 .env 后按实际环境修改

# HTTP 服务
VFILES_HTTP_HOST=0.0.0.0
VFILES_HTTP_PORT=3000
VFILES_HTTP_PUBLIC_BASE_URL=http://localhost:3000
# VFILES_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# 默认跟随 VFILES_HTTP_PUBLIC_BASE_URL 的 scheme；局域网 IP 直连调试时可显式设为 false
# VFILES_HTTP_COOKIE_SECURE=false

# 存储与数据库
VFILES_STORAGE_ROOT=./data
VFILES_DATABASE_PATH=./data/vfiles.db
# 单文件大小上限（MB，默认 4096）；前端会据此提示并在选择文件时先做校验
# VFILES_MAX_FILE_SIZE_MB=4096

# 认证
VFILES_AUTH_ENABLED=true
VFILES_AUTH_ALLOW_REGISTER=true
VFILES_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-chars

# FTP(S) 批量导入（默认开启；FTP 为明文协议，建议仅在内网使用或启用 FTPS，
# 不需要时显式设为 false）
VFILES_FTP_ENABLED=true
VFILES_FTP_HOST=0.0.0.0
VFILES_FTP_PORT=2121
# 被动模式端口段（客户端与防火墙都需要放行）
VFILES_FTP_PASSIVE_PORTS=50000-50100
# NAT/端口映射时对外通告的地址
# VFILES_FTP_PASSIVE_HOST=files.example.com
# 允许登录的角色，逗号分隔；留空表示不限制
VFILES_FTP_ALLOWED_ROLES=admin,manager
# VFILES_FTP_MAX_CONNECTIONS=8
# VFILES_FTP_IDLE_TIMEOUT_SECONDS=300
# 快照策略：batch（默认）/ per-file / off
VFILES_FTP_SNAPSHOT_MODE=batch
VFILES_FTP_SNAPSHOT_FLUSH_FILES=200
# 显式 FTPS（PEM 证书与私钥；两者同时配置才生效）
# VFILES_FTP_TLS_CERT=/etc/vfiles/ftp-cert.pem
# VFILES_FTP_TLS_KEY=/etc/vfiles/ftp-key.pem
# VFILES_FTP_TLS_REQUIRED=true

# rsync daemon（默认关；VFILES_RSYNC_ENABLED=true 显式开启）
# VFILES_RSYNC_ENABLED=false
# VFILES_RSYNC_PORT=873
# VFILES_RSYNC_MODULE=files
# 写权限（默认 false = 只读；push 需显式开启）
# VFILES_RSYNC_WRITABLE=false
# 认证（逗号分隔；条目可带 :ro / :rw / :deny；留空 = 匿名）
# VFILES_RSYNC_AUTH_USERS=alice,bob:ro
# secrets 文件（每行 user:password；建议 chmod 600）
# VFILES_RSYNC_SECRETS_FILE=/etc/vfiles/rsyncd.secrets

# S3 兼容 API（默认关；VFILES_S3_ENABLED=true 显式开启）
# VFILES_S3_ENABLED=false
# VFILES_S3_PORT=9000
# VFILES_S3_ACCESS_KEY=change-me
# VFILES_S3_SECRET_KEY=change-me
# 额外凭证（逗号分隔；与上面单对并存，用于多客户端/轮换/只读）
# 条目形 access:secret[:命名空间slug][:ro]（ro = 只读，变更类操作一律 AccessDenied；
# 给 slug 即把该凭证**限定到那个命名空间** = 多租户隔离）
# VFILES_S3_CREDENTIALS=client2:secret2,reader:secret3:ro,tenant:secret4:tenant2,tenantro:secret5:tenant2:ro
# 期望签名区域（空 = 不校验（兼容优先默认）✗ 设置后不符即 AuthorizationHeaderMalformed 400）
# VFILES_S3_REGION=us-east-1

# 前端静态资源
# 未启用 embed feature 时，服务会优先探测 client/dist
# VFILES_FRONTEND_DIST=./client/dist

# 日志
RUST_LOG=info
